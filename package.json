  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1136.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1136.0",
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-eventbridge": "^3.1141.0",
    "@aws-sdk/client-sns": "3.1141.0",
    "@aws-sdk/client-sqs": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
